# Copy this file to .env and replace every placeholder before running RutinKu.
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

database.default.hostname = localhost
database.default.database = rutinku
database.default.username = rutinku_user
database.default.password = 'CHANGE_ME'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Production must use HTTPS and secure cookies.
cookie.prefix = 'rutinku_'
cookie.secure = false
cookie.httponly = true
cookie.samesite = Lax

session.driver = 'CodeIgniter\\Session\\Handlers\\FileHandler'
session.cookieName = 'rutinku_session'
session.expiration = 2592000
# Keep Config\\Session default (WRITEPATH/session), or set an absolute server path.
# session.savePath = '/absolute/private/path/to/writable/session'
session.timeToUpdate = 300
session.regenerateDestroy = true

security.csrfProtection = session
security.tokenName = 'rutinku_csrf_token'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'rutinku_csrf_cookie'
security.regenerate = true

# Set a random key for production (php spark key:generate).
encryption.key =

logger.threshold = 4

# One-time ProductionSeeder input. Set privately; never commit real credentials.
# Blank values deliberately make initialization fail until configured.
RUTINKU_FAMILY_NAME =
RUTINKU_PARENT1_NAME =
RUTINKU_PARENT1_EMAIL =
RUTINKU_PARENT1_PASSWORD =
RUTINKU_PARENT2_NAME =
RUTINKU_PARENT2_EMAIL =
RUTINKU_PARENT2_PASSWORD =

# -----------------------------------------------------------------------------
# Production overrides (uncomment and replace values on cPanel)
# -----------------------------------------------------------------------------
# CI_ENVIRONMENT = production
# app.baseURL = 'https://rutinku.example.com/'
# app.forceGlobalSecureRequests = true
# cookie.secure = true
